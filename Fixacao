8. Estrutura do Curso (Associação de Lista)
Java
import java.util.List;

class Participante {
    String nome;
    public Participante(String nome) { this.nome = nome; }
    public void apresentar() { System.out.println("Participante: " + nome); }
}
class ProfResponsavel extends Participante {
    public ProfResponsavel(String nome) { super(nome); }
    @Override public void apresentar() { System.out.println("[Professor] Meu nome é " + nome + ". Serei o responsável pelas aulas."); }
}
class AlunoMatriculado extends Participante {
    public AlunoMatriculado(String nome) { super(nome); }
    @Override public void apresentar() { System.out.println("[Aluno] Oi, meu nome é " + nome + " e estou pronto para aprender."); }
}
class Curso {
    String nomeCurso;
    ProfResponsavel professor;
    List<AlunoMatriculado> alunos;
    public Curso(String nomeCurso, ProfResponsavel professor, List<AlunoMatriculado> alunos) {
        this.nomeCurso = nomeCurso; this.professor = professor; this.alunos = alunos;
    }
    public void apresentarCurso() {
        System.out.println("--- Curso: " + nomeCurso + " ---");
        professor.apresentar();
        alunos.forEach(AlunoMatriculado::apresentar);
    }
}
