10. Plataforma Educacional (Gestão de Turma)
Java
import java.util.List;

class Usuario {
    String nome;
    public Usuario(String nome) { this.nome = nome; }
    public void seApresentar() { System.out.println("Usuário: " + nome); }
}
class Instrutor extends Usuario {
    public Instrutor(String nome) { super(nome); }
    @Override public void seApresentar() { System.out.println("👨‍🏫 Instrutor Titular: " + nome); }
}
class Estudante extends Usuario {
    public Estudante(String nome) { super(nome); }
    @Override public void seApresentar() { System.out.println("👨‍🎓 Estudante Matriculado: " + nome); }
}
class Turma {
    String codigoTurma;
    Instrutor instrutor;
    List<Estudante> estudantes;
    public Turma(String codigoTurma, Instrutor instrutor, List<Estudante> estudantes) {
        this.codigoTurma = codigoTurma; this.instrutor = instrutor; this.estudantes = estudantes;
    }
    public void exibirPainel() {
        System.out.println("Turma: " + codigoTurma);
        instrutor.seApresentar();
        estudantes.forEach(Estudante::seApresentar);
    }
}
