6. Profissionais da Universidade (Herança com super)
Java
class Professor {
    String nome;
    public Professor(String nome) { this.nome = nome; }
    public void apresentar() { System.out.println("Olá, sou o Professor " + nome); }
}
class Coordenador extends Professor {
    String departamento;
    public Coordenador(String nome, String departamento) { super(nome); this.departamento = departamento; }
    @Override
    public void apresentar() {
        super.apresentar(); // Reaproveita a apresentação base
        System.out.println("Também atuo como Coordenador do departamento de " + departamento);
    }
}
